                if (playlist.length === 0) return;
                
                if (direction === 'up') {
                    setIpodSelection((prev) => (prev > 0 ? prev - 1 : playlist.length - 1));
                } else {
                    setIpodSelection((prev) => (prev < playlist.length - 1 ? prev + 1 : 0));
