                                            />
                                            <button
                                                onClick={() => setIpodColor('pink')}
                                                className={`w-10 h-10 rounded-full bg-gradient-to-br from-pink-300 to-pink-400 border-2 ${ipodColor === 'pink' ? 'border-slate-800 ring-2 ring-pink-300' : 'border-pink-500'} transition-all hover:scale-110`}
                                                title="Pink"
                                            />
                                            <button
                                                onClick={() => setIpodColor('green')}
                                                className={`w-10 h-10 rounded-full bg-gradient-to-br from-green-400 to-green-500 border-2 ${ipodColor === 'green' ? 'border-slate-800 ring-2 ring-green-300' : 'border-green-600'} transition-all hover:scale-110`}
                                                title="Green"
                                            />
                                        </div>
                                    </div>

                                    <div className="relative">
                                        {/* iPod Body */}
                                        <div className={`w-80 bg-gradient-to-b ${colorSchemes[ipodColor].body} rounded-[2.5rem] shadow-2xl border-4 ${colorSchemes[ipodColor].border} p-6`}>
                                            {/* Screen */}
                                            <div className="bg-gradient-to-b from-green-100 to-green-50 rounded-2xl border-4 border-slate-700 p-4 mb-8 h-64 overflow-hidden">
                                                <div className="bg-white border-2 border-slate-600 rounded-lg h-full p-3 overflow-y-auto text-sm" style={{fontFamily: 'Helvetica, Arial, sans-serif'}}>
                                                    <div className="border-b-2 border-slate-700 pb-2 mb-2">
                                                        <p className="text-center font-bold text-slate-800">MY PLAYLIST</p>
                                                        <p className="text-center text-xs text-slate-600">{playlist.length} songs</p>
                                                    </div>
                                                    
                                                    {playlist.length === 0 ? (
                                                        <div className="flex items-center justify-center h-32">
                                                            <p className="text-slate-500 text-xs text-center">Add songs to start<br/>your playlist</p>
                                                        </div>
                                                    ) : (
                                                        <div className="space-y-1">
                                                            {playlist.map((song, idx) => (
                                                                <div
                                                                    key={song.id}
                                                                    className={`p-2 rounded ${
                                                                        idx === ipodSelection
                                                                            ? 'bg-blue-600 text-white'
                                                                            : 'text-slate-800'
                                                                    }`}
                                                                >
                                                                    <p className="font-bold text-xs truncate">{song.title}</p>
                                                                    <p className="text-xs truncate">{song.artist}</p>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    )}
                                                </div>
                                            </div>

                                            {/* Click Wheel */}
                                            <div className="relative w-48 h-48 mx-auto">
                                                <div className={`absolute inset-0 rounded-full bg-gradient-to-br ${colorSchemes[ipodColor].wheel} shadow-inner`}>
                                                    <div className="absolute inset-2 rounded-full border-2 border-slate-400">
                                                        <button
                                                            className="absolute top-2 left-1/2 transform -translate-x-1/2 w-12 h-8 flex items-center justify-center text-xs font-bold text-slate-700 hover:text-slate-900 transition-colors"
                                                            onClick={() => {}}
                                                        >
                                                            MENU
                                                        </button>
                                                        
                                                        <button
                                                            className="absolute right-2 top-1/2 transform -translate-y-1/2 w-8 h-12 flex items-center justify-center text-slate-700 hover:text-slate-900 transition-colors"
                                                            onClick={() => handleIpodScroll('down')}
                                                        >
                                                            <div className="w-0 h-0 border-t-8 border-t-transparent border-l-8 border-l-slate-700 border-b-8 border-b-transparent"></div>
                                                        </button>
                                                        
                                                        <button
                                                            className="absolute bottom-2 left-1/2 transform -translate-x-1/2 w-12 h-8 flex items-center justify-center text-slate-700 hover:text-slate-900 transition-colors"
                                                            onClick={() => {}}
                                                        >
                                                            <div className="flex gap-1">
                                                                <div className="w-0 h-0 border-t-6 border-t-transparent border-l-8 border-l-slate-700 border-b-6 border-b-transparent"></div>
                                                                <div className="w-1 h-3 bg-slate-700"></div>
                                                                <div className="w-1 h-3 bg-slate-700"></div>
                                                            </div>
                                                        </button>
                                                        
                                                        <button
                                                            className="absolute left-2 top-1/2 transform -translate-y-1/2 w-8 h-12 flex items-center justify-center text-slate-700 hover:text-slate-900 transition-colors"
                                                            onClick={() => handleIpodScroll('up')}
                                                        >
                                                            <div className="w-0 h-0 border-t-8 border-t-transparent border-r-8 border-r-slate-700 border-b-8 border-b-transparent"></div>
                                                        </button>
                                                    </div>
                                                </div>
                                                
                                                <button
                                                    onClick={() => {
                                                        if (playlist[ipodSelection]) {
                                                            setSelectedSong(playlist[ipodSelection]);
                                                            setTimeout(() => lucide.createIcons(), 0);
                                                        }
                                                    }}
                                                    className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-gradient-to-br from-slate-200 to-slate-400 shadow-lg hover:from-slate-300 hover:to-slate-500 transition-all active:scale-95"
                                                >
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {/* Current Playlist (List View) */}
                            {playlist.length > 0 && (
                                <div className="mt-8 bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-slate-200 p-6">
                                    <h3 className="text-lg font-medium text-slate-800 mb-4">Your Playlist</h3>
                                    <div className="space-y-2">
                                        {playlist.map((song, idx) => (
                                            <div
                                                key={song.id}
                                                className="flex items-center justify-between p-4 hover:bg-slate-50 rounded-xl transition-colors border border-slate-100"
                                            >
                                                <div className="flex items-center gap-4 flex-1">
                                                    <span className="text-slate-400 font-mono text-sm w-8">{idx + 1}</span>
                                                    <div>
                                                        <p className="font-medium text-slate-800">{song.title}</p>
                                                        <p className="text-sm text-slate-500">{song.artist}</p>
                                                    </div>
                                                </div>
                                                <button
                                                    onClick={() => removeFromPlaylist(song.id)}
                                                    className="p-2 hover:bg-red-50 rounded-full transition-colors group"
                                                >
                                                    <div style={{width: '18px', height: '18px'}} className="text-slate-400 group-hover:text-red-500">
                                                        <X />
                                                    </div>
                                                </button>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            );
        }

        // Render the app
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<PlaylistCreator />);
        
        // Initialize Lucide icons after render
        setTimeout(() => lucide.createIcons(), 100);
    </script>
</body>
</html>
